<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/btnVolverProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seller_orders_volver_al_panel"
        android:textColor="@color/indigo_primary"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        style="@style/TitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seller_profile_mi_tienda" />

    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:background="@color/indigo_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="@string/seller_profile_ludoteca_el_meeple"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/indigo_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/seller_profile_4_8_de_5_126_ventas"
        android:textColor="@color/orange_cta" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/teal_confirm"
        android:text="@string/seller_profile_editar_perfil_de_la_tien"
        android:textAllCaps="false" />
</LinearLayout>