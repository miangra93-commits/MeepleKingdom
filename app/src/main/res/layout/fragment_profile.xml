<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mi Perfil"
        android:textColor="@color/indigo_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Botones para simular el cambio de rol -->
    <Button
        android:id="@+id/btnRolVendedor"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/indigo_primary"
        android:text="Panel de Vendedor"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnRolAdmin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/soft_red"
        android:text="Panel de Administrador"
        android:textAllCaps="false" />

</LinearLayout>