<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/imgCart"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="#EEEEEE"
        android:contentDescription="@string/item_producto_foto_del_producto"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCartNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/indigo_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCartPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/orange_cta" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMenos"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:backgroundTint="@color/indigo_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/item_cart_txt"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvCartCantidad"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMas"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:backgroundTint="@color/indigo_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/item_cart_txt_2"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnQuitar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:padding="8dp"
                android:text="@string/item_cart_quitar"
                android:textColor="@color/soft_red"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
