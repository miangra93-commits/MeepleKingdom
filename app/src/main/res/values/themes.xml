<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MeepleKingdom" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/indigo_primary</item>
        <item name="colorPrimaryVariant">@color/indigo_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orange_cta</item>
        <item name="colorSecondaryVariant">@color/orange_cta</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/cream_background</item>
        <item name="android:statusBarColor">@color/indigo_primary</item>
    </style>

    <style name="TitleText">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/indigo_primary</item>
    </style>

    <style name="SubtitleText">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/indigo_primary</item>
    </style>
</resources>