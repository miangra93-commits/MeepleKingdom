rules_version = '2';
// Reglas de seguridad de Cloud Firestore - Meeple Kingdom
// Roles: 'admin', 'vendedor', 'comprador' (campo users/{uid}.rol)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() { return hasProfile() && profile().rol == 'admin'; }
    function isSeller() { return hasProfile() && profile().rol == 'vendedor'; }
    function isBuyer() { return hasProfile() && profile().rol == 'comprador'; }

    // ---------- Usuarios ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Auto-registro: solo comprador o vendedor, activo. El admin puede crear cualquier rol.
      allow create: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.rol in ['comprador', 'vendedor']
          && request.resource.data.activo == true)
        || isAdmin());
      // Un usuario edita sus datos pero NO su rol ni su estado.
      allow update: if isAdmin() || (request.auth.uid == uid
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.activo == resource.data.activo);
      allow delete: if isAdmin();

      // Carrito: solo su dueño lo lee y lo modifica.
      match /cart/{productId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- Productos ----------
    match /products/{id} {
      allow read: if signedIn();
      allow create: if isSeller()
          && request.resource.data.vendedorId == request.auth.uid
          && request.resource.data.bloqueado == false;
      // El vendedor edita lo suyo sin tocar 'bloqueado'; el admin modera todo.
      allow update: if isAdmin() || (isSeller()
          && resource.data.vendedorId == request.auth.uid
          && request.resource.data.vendedorId == request.auth.uid
          && request.resource.data.bloqueado == resource.data.bloqueado)
          // Un comprador solo puede DESCONTAR stock (al confirmar una compra), nada más.
          || (isBuyer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock);
      allow delete: if isAdmin() || (isSeller() && resource.data.vendedorId == request.auth.uid);
    }

    // ---------- Pedidos ----------
    match /orders/{id} {
      // Lo ven el comprador, el vendedor del pedido y el administrador.
      allow read: if signedIn() && (resource.data.compradorId == request.auth.uid
          || resource.data.vendedorId == request.auth.uid
          || isAdmin());
      allow create: if isBuyer()
          && request.resource.data.compradorId == request.auth.uid
          && request.resource.data.estado == 'pendiente_pago';
      // Solo se cambia el estado, y con transiciones válidas. 'pagado' NO aparece aquí:
      // únicamente la Cloud Function (Admin SDK) del webhook de ePayco puede marcar un pedido como pagado.
      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
          && (
            // El administrador puede cancelar pedidos abiertos (libera el stock reservado).
            (isAdmin() && request.resource.data.estado == 'cancelado'
              && resource.data.estado in ['pendiente_pago', 'pagado'])
            || (resource.data.vendedorId == request.auth.uid && (
              (resource.data.estado == 'pagado' && request.resource.data.estado == 'enviado')
              || (resource.data.estado == 'enviado' && request.resource.data.estado == 'entregado')
              || (resource.data.estado in ['pendiente_pago', 'pagado']
                  && request.resource.data.estado == 'cancelado')))
          );
    }
  }
}
